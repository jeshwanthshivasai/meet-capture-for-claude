{
  "manifest_version": 3,
  "name": "Meet Capture for Claude",
  "short_name": "Meet Capture",
  "version": "1.0.0",
  "description": "Unofficial. Saves Google Meet captions and screen-share snapshots into one Claude-ready file, locally. No bot, no account.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Meet Capture",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "sidePanel",
    "offscreen"
  ],
  "host_permissions": [
    "https://meet.google.com/*"
  ],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/common.js",
        "src/captions.js",
        "src/snapshot.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "snapshot-now": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Take a snapshot of the shared screen"
    }
  }
}
